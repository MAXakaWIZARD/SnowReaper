{
    "name": "maxakawizard/snow-reaper",
    "description": "Snowrunner utility",
    "version": "0.2.1",
    "license": "MIT",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "App\\": [
                "src/"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "8.5.2"
        }
    },
    "require": {
        "php": "^8.5",
        "symfony/console": "~8.1",
        "symfony/dotenv": "~8.1",
        "symfony/finder": "~8.1",
        "symfony/process": "~8.1"
    },
    "require-dev": {
        "marcocesarato/php-conventional-changelog": "~1.0"
    },
    "scripts": {
        "changelog": "conventional-changelog",
        "changelog-rewrite": "conventional-changelog --history",
        "release": "conventional-changelog --commit --no-change-without-commits"
    }
}